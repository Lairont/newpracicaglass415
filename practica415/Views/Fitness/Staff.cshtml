@model FitnessDashboardViewModel
@{ ViewData["Title"] = "Клиенты клуба"; var today = DateTime.Today; var overdue = Model.Clients.Where(x => x.MembershipEnd < today).ToList(); }
<div class="page-heading"><div><div class="eyebrow">FITSTOCK CLUB · ПЕРСОНАЛ</div><h1>Клиенты клуба</h1><p>Абонементы, сроки действия и аккаунты клиентов.</p></div><a class="btn btn-primary" asp-action="CreateClient">＋ Добавить клиента</a></div>
@if (overdue.Count > 0) { <div class="member-message member-expired"><strong>Должники: @overdue.Count</strong><span>@string.Join(", ", overdue.Select(x => x.FullName ?? x.Login)) — срок абонемента истёк.</span></div> }
@if (Model.TemporaryPassword is not null && Model.Client is not null) { <div class="issued-account"><strong>@(TempData["PasswordAction"]?.ToString() ?? "Аккаунт клиента создан")</strong><span>Логин: @Model.Client.Email</span><span>Временный пароль: <code>@Model.TemporaryPassword</code></span><small>Скопируй пароль и передай клиенту. После ухода со страницы его нельзя будет посмотреть снова.</small></div> }
<section class="panel"><div class="panel-header"><div><h2>Список клиентов</h2><p>@Model.Clients.Count клиентов</p></div></div>
@if (Model.Clients.Count == 0) { <div class="empty-note">Клиентов пока нет. Добавь первую запись после оформления абонемента.</div> }
else { <div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>КЛИЕНТ</th><th>АБОНЕМЕНТ</th><th>ДЕЙСТВУЕТ ДО</th><th>СТАТУС</th><th>ИЗМЕНИТЬ ДАННЫЕ</th><th>ДОСТУП</th></tr></thead><tbody>
@foreach (var client in Model.Clients) { var days = client.MembershipEnd.HasValue ? (client.MembershipEnd.Value.Date - today).Days : -1; <tr><td><strong>@client.FullName</strong><small class="table-secondary">@client.Email</small><small class="table-secondary">@client.Phone</small></td><td>@(client.MembershipPlan ?? "—")</td><td>@client.MembershipEnd?.ToString("dd.MM.yyyy")</td><td>@if (!client.MembershipEnd.HasValue) { <span class="status-pill">Нет абонемента</span> } else if (days < 0) { <span class="status-pill status-cancelled">Должник</span> } else if (days <= 1) { <span class="status-pill status-pending">Истекает</span> } else { <span class="status-pill status-completed">Активен</span> }</td><td><form asp-action="Renew" method="post" class="renew-form"><input type="hidden" name="id" value="@client.Id" /><input type="text" name="fullName" value="@client.FullName" class="form-control" aria-label="ФИО" /><input type="text" name="phone" value="@client.Phone" class="form-control" aria-label="Телефон" /><input type="date" name="startDate" value="@today.ToString("yyyy-MM-dd")" class="form-control" aria-label="Дата начала абонемента" /><select name="plan" class="form-select" aria-label="Срок абонемента"><option value="1month">1 мес.</option><option value="3months">3 мес.</option><option value="6months">6 мес.</option><option value="1year">1 год</option></select><button class="btn btn-sm btn-outline-primary">Обновить</button></form></td><td><form asp-action="ResetPassword" method="post" data-confirm="Выдать клиенту новый временный пароль? Старый перестанет работать."><input type="hidden" name="id" value="@client.Id" /><button class="btn btn-sm btn-light" type="submit">Выдать новый пароль</button></form></td></tr> }
</tbody></table></div> }
</section>
