@model FitnessDashboardViewModel
@{ ViewData["Title"] = "Мой FitStock"; var client = Model.Client!; var remaining = client.MembershipEnd.HasValue ? (client.MembershipEnd.Value.Date - DateTime.Today).Days : -1; var totalDays = client.MembershipStart.HasValue && client.MembershipEnd.HasValue ? Math.Max(1, (client.MembershipEnd.Value.Date - client.MembershipStart.Value.Date).Days + 1) : 1; var elapsed = client.MembershipStart.HasValue ? Math.Clamp((DateTime.Today - client.MembershipStart.Value.Date).Days, 0, totalDays) : 0; var progress = client.MembershipEnd.HasValue && remaining >= 0 ? Math.Clamp(100 - remaining * 100 / totalDays, 0, 100) : 100; }
<section class="club-hero">
    <div class="club-hero-copy"><span class="club-kicker">ТВОЙ FITSTOCK CLUB</span><h1>Тренируйся<br />в своём ритме.</h1><p>Привет, @(client.FullName?.Split(' ').FirstOrDefault() ?? client.Login). Здесь собрана информация о твоём абонементе.</p><a class="club-shop-link" asp-controller="Products" asp-action="Index">Заглянуть в магазин <span>↗</span></a></div>
    <div class="club-hero-art" aria-hidden="true"><div class="club-orbit orbit-one"></div><div class="club-orbit orbit-two"></div><svg class="club-gym-mark" viewBox="0 0 240 100" focusable="false"><rect x="48" y="44" width="144" height="12" rx="6" fill="#39594c"/><rect x="34" y="27" width="22" height="46" rx="5" fill="#39594c"/><rect x="18" y="34" width="12" height="32" rx="4" fill="#c58258"/><rect x="184" y="27" width="22" height="46" rx="5" fill="#39594c"/><rect x="210" y="34" width="12" height="32" rx="4" fill="#c58258"/></svg><div class="club-art-label">TRAIN<br />CLUB</div></div>
</section>
@if (client.MembershipEnd is null) { <div class="member-message"><strong>Абонемент пока не назначен</strong><span>Менеджер клуба добавит план после оформления.</span></div> }
else if (remaining is >= 0 and <= 1) { <div class="member-message member-warning"><strong>Абонемент заканчивается @(remaining == 0 ? "сегодня" : "завтра").</strong><span>Напиши менеджеру, чтобы продлить его.</span></div> }
else if (remaining < 0) { <div class="member-message member-expired"><strong>Срок абонемента истёк.</strong><span>Свяжись с менеджером клуба для продления.</span></div> }
<section class="member-home-grid">
    <article class="membership-card member-main-card"><div class="membership-card-top"><span>ТВОЯ КЛУБНАЯ КАРТА</span><span class="membership-status">@(client.MembershipEnd is null ? "Не назначен" : remaining < 0 ? "Истёк" : "Активен")</span></div><div class="member-plan-row"><div><small>Текущий план</small><h2>@(client.MembershipPlan ?? "Абонемент не выбран")</h2></div><div class="member-stamp">FS<span>CLUB</span></div></div><div class="member-progress"><div><span>ПРОГРЕСС АБОНЕМЕНТА</span><strong>@(remaining < 0 || client.MembershipEnd is null ? "—" : $"{remaining} дней осталось")</strong></div><div class="progress-track"><span style="width:@progress%"></span></div></div><div class="membership-dates"><div><small>НАЧАЛО</small><strong>@client.MembershipStart?.ToString("dd.MM.yyyy")</strong></div><div><small>ДЕЙСТВУЕТ ДО</small><strong>@client.MembershipEnd?.ToString("dd.MM.yyyy")</strong></div><div><small>ДНЕЙ С НАЧАЛА</small><strong>@elapsed</strong></div></div></article>
    <aside class="member-side-card"><div class="member-side-icon">✦</div><span class="club-kicker">ТВОЯ ЦЕЛЬ</span><h2>Сильнее<br />каждый день.</h2><p>Регулярность важнее идеального плана. Увидимся на тренировке.</p><div class="side-card-line"></div><small>FITSTOCK CLUB · MOVE YOUR WAY</small></aside>
</section>
<section class="member-details member-details-modern"><div class="member-section-title"><div><span class="club-kicker">ЛИЧНЫЙ КАБИНЕТ</span><h2>Твои данные</h2></div><div class="member-avatar"><img src="@(client.AvatarPath ?? "/images/avatar-default.svg")" alt="" /></div></div><div class="member-data-grid"><div><small>ФИО</small><strong>@(client.FullName ?? "Не указано")</strong></div><div><small>ТЕЛЕФОН</small><strong>@(client.Phone ?? "Не указан")</strong></div><div><small>ПОЧТА ДЛЯ ВХОДА</small><strong>@client.Email</strong></div></div><p>Для изменения данных или восстановления доступа обратись к менеджеру клуба.</p></section>
