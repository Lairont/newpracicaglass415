@model ReportsViewModel
@{ ViewData["Title"] = "Отчёты клуба"; }
<div class="page-heading"><div><div class="eyebrow">FITSTOCK CLUB · ПЕРСОНАЛ</div><h1>Отчёты</h1><p>Клиенты, абонементы и остатки магазина.</p></div><a class="btn btn-outline-secondary" asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">↓ CSV по остаткам</a></div>
<section class="panel report-filter"><form method="get" class="date-filter"><label>Период с<input class="form-control" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /></label><label>по<input class="form-control" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /></label><button class="btn btn-primary">Показать</button></form></section>
<section class="report-summary"><article class="report-card"><span>Клиенты клуба</span><strong>@Model.ClientCount</strong><small>всего зарегистрировано</small></article><article class="report-card"><span>Активные абонементы</span><strong>@Model.ActiveMemberships</strong><small>на текущую дату</small></article><article class="report-card"><span>Истекают завтра</span><strong>@Model.ExpiringMemberships</strong><small>нужно напомнить клиентам</small></article><article class="report-card"><span>Должники</span><strong>@Model.DebtorCount</strong><small>срок абонемента истёк</small></article><article class="report-card"><span>Стоимость товаров</span><strong>@Model.StockValue.ToString("N0") MDL</strong><small>остаток магазина</small></article></section>
<section class="panel"><div class="panel-header"><div><h2>Остатки магазина</h2><p>Спортивное питание и аксессуары</p></div></div><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>ТОВАР</th><th>КАТЕГОРИЯ</th><th>ОСТАТОК</th><th>МИНИМУМ</th><th>СТОИМОСТЬ</th></tr></thead><tbody>@foreach (var product in Model.Products) { <tr><td><strong>@product.Name</strong><small class="table-secondary">@product.Sku</small></td><td>@product.Category</td><td>@product.Quantity @product.Unit</td><td>@product.MinimumStock @product.Unit</td><td>@((product.Quantity * product.UnitPrice).ToString("N2")) MDL</td></tr> }</tbody></table></div></section>
<section class="panel"><div class="panel-header"><div><h2>Движения магазина за период</h2><p>@Model.Movements.Count операций</p></div></div>@if (Model.Movements.Count == 0) { <div class="empty-note">Операций за период нет.</div> } else { <div class="table-responsive"><table class="table data-table"><thead><tr><th>ДАТА</th><th>ОПЕРАЦИЯ</th><th>ТОВАР</th><th>КОЛИЧЕСТВО</th></tr></thead><tbody>@foreach (var item in Model.Movements) { <tr><td>@item.CreatedAt.ToString("dd.MM.yy HH:mm")</td><td>@WarehouseLabels.Movement(item.Type)</td><td>@item.ProductName</td><td>@item.Quantity @item.Unit</td></tr> }</tbody></table></div>}</section>
