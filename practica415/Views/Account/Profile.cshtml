@model ProfileViewModel
@{ ViewData["Title"] = "Профиль"; }
<div class="page-heading"><div><div class="eyebrow">УЧЁТНАЯ ЗАПИСЬ</div><h1>Профиль</h1><p>Измените имя, фотографию или пароль.</p></div></div>
<div class="profile-grid">
    <section class="panel profile-card"><h2>Данные профиля</h2><form asp-action="UpdateProfile" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="profile-avatar"><img src="@(Model.AvatarPath ?? "/images/avatar-default.svg")" alt="Аватар" /></div><div class="mb-3"><label asp-for="Avatar" class="form-label">Фото профиля</label><input asp-for="Avatar" class="form-control" type="file" accept="image/png,image/jpeg,image/webp" /><span asp-validation-for="Avatar" class="text-danger small"></span><div class="form-text">PNG, JPG или WebP, до 2 МБ.</div></div><div class="mb-3"><label asp-for="Login" class="form-label">Ник</label><input asp-for="Login" class="form-control" /><span asp-validation-for="Login" class="text-danger small"></span></div><div class="mb-3"><label class="form-label">Электронная почта</label><input class="form-control" value="@Model.Email" readonly /></div><button class="btn btn-primary" type="submit">Сохранить профиль</button></form></section>
    <section class="panel profile-card"><h2>Изменить пароль</h2><form asp-controller="Account" asp-action="ChangePassword" method="post"><div class="mb-3"><label class="form-label" for="currentPassword">Текущий пароль</label><input class="form-control" id="currentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required /></div><div class="mb-3"><label class="form-label" for="newPassword">Новый пароль</label><input class="form-control" id="newPassword" name="NewPassword" type="password" minlength="8" autocomplete="new-password" required /></div><div class="mb-3"><label class="form-label" for="confirmPassword">Повторите новый пароль</label><input class="form-control" id="confirmPassword" name="ConfirmPassword" type="password" minlength="8" autocomplete="new-password" required /></div><button class="btn btn-outline-primary" type="submit">Обновить пароль</button></form></section>
</div>
